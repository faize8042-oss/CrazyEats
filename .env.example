# Export these variables in your environment. Django does not auto-load this file.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-unique-random-secret-of-at-least-50-characters
DJANGO_ALLOWED_HOSTS=your-domain.example
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.example
DJANGO_TIME_ZONE=Asia/Karachi
POSTGRES_DB=crazyeats
POSTGRES_USER=crazyeats
POSTGRES_PASSWORD=replace-me
POSTGRES_HOST=db
POSTGRES_PORT=5432
EMAIL_HOST=smtp.your-provider.example
EMAIL_PORT=587
EMAIL_HOST_USER=replace-me
EMAIL_HOST_PASSWORD=replace-me
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=CrazyEats <orders@your-domain.example>

SITE_DOMAIN=your-domain.example
DJANGO_TRUST_PROXY=true
COMMERCE_CURRENCY=PKR

DEMO_MODE=false
OPERATOR_NAME=
SUPPORT_EMAIL=
